APP_ENV=development
APP_PORT=8000
ORCHESTRATOR_API_KEY=replace-with-a-long-random-secret
TENANT_SIGNING_SECRET=replace-with-a-separate-random-secret
TENANT_BODY_SIGNATURE_REQUIRED=false
REDIS_URL=
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-3.1-flash-lite
GEMINI_ADVANCED_MODEL=gemini-3.1-pro-preview
