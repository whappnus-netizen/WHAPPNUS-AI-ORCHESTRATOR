TOTAL_REQUEST_TIMEOUT_SECONDS=22
MAX_RETRIES=2
MAX_RATE_LIMIT_RETRIES=1
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_INPUT_TOKENS=100000
MAX_OUTPUT_TOKENS=4096
MODEL_LIMITS_JSON={}
MODEL_PRICING_JSON={}
